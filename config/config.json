{
  "lists_dir": "data/lists",
  "rules_dir": "rules",
  "outbound_dir": "data/outbound",
  "daily_brief_dir": "data/daily-brief",

  "imap": {
    "host": "127.0.0.1",
    "port": 1143,
    "mailbox": "INBOX",
    "tls": "starttls",
    "ca_file": null,
    "poll_interval_seconds": 30,
    "max_attempts": 3,
    "concurrency": 4,
    "scan_timeout_seconds": 120,
    "idle": true,
    "idle_timeout_seconds": 1500
  },

  "dispatcher": {
    "state_file": "data/dispatcher/state.json",
    "quarantine_log": "data/dispatcher/quarantine.log",
    "webhook_url": null,
    "scanner_runner": "subprocess",
    "container": {
      "image": "email-guard-scanner:0.1.0",
      "memory": "512m",
      "pids_limit": 128,
      "cpus": "1.0",
      "tmpfs_size": "64m",
      "spool_dir": "data/dispatcher/scan-spool"
    }
  },

  "webui": {
    "host": "127.0.0.1",
    "port": 8080,
    "frame_ancestors": "'none'"
  }
}
