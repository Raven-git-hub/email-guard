# Email Guard host-side publisher -- copy to /etc/email-guard/publisher.env
#
#   sudo install -d -m 0755 /etc/email-guard
#   sudo install -m 0644 publisher/systemd/publisher.env.sample \
#        /etc/email-guard/publisher.env
#   sudoedit /etc/email-guard/publisher.env
#
# Read by BOTH host units -- email-guard-publisher.service and
# email-guard-cleanup.service -- so the tree, the destination and the retention
# window are configured once and cannot skew between them.
#
# systemd's EnvironmentFile syntax is NAME=value, one per line. It is not a
# shell: no `export`, no `$OTHER` expansion, no command substitution. Quotes are
# stripped, so leave them off unless a value has trailing spaces.
#
# After editing:  sudo systemctl daemon-reload   (not needed for this file, but
# harmless) and check what a run would do, changing nothing:
#
#   sudo -u '#1000' env $(cat /etc/email-guard/publisher.env | xargs) \
#        PYTHONPATH=/opt/email-guard/publisher \
#        python3 -m email_guard_publisher status

# ---------------------------------------------------------------------------
# The scanner's output tree, AS SEEN FROM THE HOST.
# ---------------------------------------------------------------------------
# NOT the /app/data/outbound path a container sees. Under compose this is the
# bind source of the email-guard-data volume: ${EMAIL_GUARD_HOST_ROOT}/data/
# outbound, with EMAIL_GUARD_HOST_ROOT taken from the repo's .env.
#
# The publisher writes `.published` markers in here, so the unit's user needs
# write access to it -- which is why it runs as the same uid as the containers.
EMAIL_GUARD_OUTBOUND_DIR=/opt/email-guard/data/outbound

# ---------------------------------------------------------------------------
# The network partition. The one path in this system that leaves the host.
# ---------------------------------------------------------------------------
# Job packages land at ${EMAIL_GUARD_PUBLISH_DEST}/<bucket>/<job>/ and are the
# downstream consumer's input. This path must be on the MOUNTED partition --
# the copy is staged inside the destination bucket so the final step is an
# atomic rename, and a rename cannot cross a filesystem.
#
# No container is ever given this path. If you find yourself adding it to a
# compose volume, stop: the host publisher exists precisely so the sandbox
# never has to.
EMAIL_GUARD_PUBLISH_DEST=/mnt/network/acheron/email-guard

# ---------------------------------------------------------------------------
# Optional: which buckets are published.
# ---------------------------------------------------------------------------
# All three by default. Narrow it to `cleared` if quarantined mail should never
# leave the host -- flagged and rejected jobs then stay local (and, having no
# `.published` marker, are never expired by the retention sweep either).
# EMAIL_GUARD_PUBLISH_BUCKETS=cleared,flagged,rejected

# ---------------------------------------------------------------------------
# Optional: how long a PUBLISHED job stays on local disk. Default 14 days.
# ---------------------------------------------------------------------------
# Counted from the moment the job was published, not scanned. Unpublished jobs
# are never deleted at any age -- a network outage costs disk, never mail.
# Set 0 to delete a job as soon as the next daily sweep sees it published.
# EMAIL_GUARD_OUTBOUND_RETENTION_DAYS=14
