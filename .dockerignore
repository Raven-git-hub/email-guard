# The build context is a copy of the working tree handed to the daemon, so the
# personal data in `data/` must not be in it -- the Dockerfile copies explicit
# paths and would not include it either way, but a build context is a copy all
# the same (root README, "Storage & privacy").
data/
config/secrets.json

# The rules auto-updater's promoted releases and its sparse git working copy.
# Derived state that belongs to the host, mounted at runtime -- and `work/`
# carries a whole `.git`, which is exactly what `.git/` below exists to keep
# out of a build context.
rules-live/

# Holds the bridge-generated IMAP credentials. Compose reads it from the host;
# no image has any business containing it.
.env

.git/
.gitignore
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Test corpora and reference material are not needed to run any service.
tests/
reference/
README.md
