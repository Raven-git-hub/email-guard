# Email Guard -- copy to `.env` and fill in. `.env` is git-ignored.
#
# Compose reads this file automatically. Everything marked REQUIRED has no
# usable default and compose will refuse to start without it.

# ---------------------------------------------------------------------------
# REQUIRED: this repository's absolute path ON THE HOST.
# ---------------------------------------------------------------------------
# The dispatcher asks the host's docker daemon to bind directories into each
# scanner container, and the daemon resolves those paths on the host -- not
# inside the dispatcher's filesystem. This is how the dispatcher learns what
# its own mounts are called from outside.
#
# It must be absolute, and it must be the real path on the machine running the
# daemon. `pwd` in this directory, on that machine.
#
# Getting it wrong fails quietly: the scanner container starts, finds nothing
# where the rules pack should be, and reports a rules-pack error. See
# VALIDATION.md.
EMAIL_GUARD_HOST_ROOT=/absolute/path/to/email-guard

# ---------------------------------------------------------------------------
# REQUIRED: the EXISTING, ALREADY-LOGGED-IN Proton Bridge config directory.
# ---------------------------------------------------------------------------
# This stack reuses the bridge that is already set up rather than initialising
# a new one -- pointing this at an empty directory forces the whole account
# login and keychain dance again.
#
# For shenxn/protonmail-bridge this is whatever is currently mounted at /root
# in the running bridge container. Confirm with:
#     docker inspect -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{"\n"}}{{end}}' <bridge-container>
EMAIL_GUARD_BRIDGE_CONFIG_DIR=/absolute/path/to/protonmail-bridge-config

# ---------------------------------------------------------------------------
# REQUIRED: the BRIDGE-GENERATED IMAP credentials.
# ---------------------------------------------------------------------------
# Not the Proton account password. Find them in the Bridge app under the
# account's "Mailbox details" / "Configure".
EMAIL_GUARD_IMAP_USERNAME=you@proton.me
EMAIL_GUARD_IMAP_PASSWORD=the-bridge-generated-password

# ---------------------------------------------------------------------------
# TLS to the bridge.
# ---------------------------------------------------------------------------
# Under compose the bridge is reached at the service name `bridge`, not at
# 127.0.0.1, so it is no longer covered by the loopback exemption that lets a
# self-signed certificate through. Verification applies, and the bridge's own
# generated certificate has to be named.
#
# Point this at that certificate, as seen from inside the dispatcher container.
# The bridge config directory above is NOT mounted into the dispatcher by
# default, so copy the cert into the repo (e.g. ./config/bridge-cert.pem) and
# reference it at /app/config/bridge-cert.pem.
#
# EMAIL_GUARD_IMAP_CA_FILE=/app/config/bridge-cert.pem
#
# Documented fallback, with its cost stated plainly: `none` disables TLS on the
# dispatcher<->bridge hop. That hop runs on an `internal: true` compose network
# with no route off the host, so the exposure is comparable to loopback -- but
# it IS a downgrade, and the bridge password crosses it. Prefer the CA file.
# EMAIL_GUARD_IMAP_TLS=none

# Which mailbox to watch. Point the first live run at a test intake mailbox.
# EMAIL_GUARD_IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------
# Run the services as your own user, so the lists and reports they write stay
# editable by hand on the host. `id -u` and `id -g`.
# A dispatcher running as root is refused: its uid becomes the scanner
# container's uid, and those must not be root.
EMAIL_GUARD_UID=1000
EMAIL_GUARD_GID=1000

# Require a shared token on every review-console API call. Worth setting on a
# shared machine, where "loopback" includes every other user on it.
# EMAIL_GUARD_WEBUI_TOKEN=
